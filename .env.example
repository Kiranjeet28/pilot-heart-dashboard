# Trusted server-side configuration only. Never prefix these with VITE_.

# Gemini planning (Module 3). Required for AI task planning — without it,
# POST /api/tasks/plan answers 500 { code: "missing_credentials" }.
# Set this in Lovable (secret "GEMINI_API_KEY") or a local .env file.
GEMINI_API_KEY=replace_with_a_server_only_key
# Optional. Defaults to gemini-2.5-flash when unset.
GEMINI_MODEL=gemini-2.5-flash

# Optional. Required only for non-browser internal planning clients (server-to-server).
# When set, requests must present `Authorization: Bearer <token>`; browser requests
# must instead prove same-origin via Origin/Referer (or Sec-Fetch-Site: same-origin
# together with a matching Origin/Referer). Requests with no origin evidence are
# rejected. Never embed this token in frontend code, URLs, or logs.
# DESKTOPPILOT_SERVER_TOKEN=replace_with_a_random_server_token
