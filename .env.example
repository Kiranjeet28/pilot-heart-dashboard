# DesktopPilot — environment template
#
# All variables below are SERVER-SIDE only (read inside server handlers).
# Never prefix them with VITE_ — that would ship them to the browser.

# ---------------------------------------------------------------------------
# AI Planner (Local Qwen llama-server)
# ---------------------------------------------------------------------------
# Task planning runs exclusively through your local llama-server.
# Hosted planning keys are server-side only; never use a VITE_ prefix.
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.8-flash
# XAI_API_KEY=your-xai-api-key
# XAI_MODEL=grok-4.7
#
# Base URL for the local llama-server instance (must be a loopback address):
LOCAL_LLM_BASE_URL=http://127.0.0.1:8081

# Model alias configured on the local llama-server:
LOCAL_LLM_MODEL=qwen

# Optional: shared token for internal (non-browser) callers of
# POST /api/tasks/plan. When set, requests must present
#   Authorization: Bearer <DESKTOPPILOT_SERVER_TOKEN>
# Browser requests instead rely on same-origin evidence (Origin/Referer
# matching the request URL). Leave unset for a browser-only deployment.
# DESKTOPPILOT_SERVER_TOKEN=replace-with-a-long-random-string

# Optional: local visual-agent worker HTTP port (worker/visual-agent).
# WORKER_PORT=8765
